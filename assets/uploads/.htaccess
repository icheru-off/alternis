# Empêche l'exécution de tout script dans le dossier d'upload,
# sans utiliser php_flag/php_value (qui provoquent une erreur 500 en PHP-FPM/CGI).
<FilesMatch "\.(php|php\d|phtml|phps|phar|pl|py|cgi|sh|asp|aspx|jsp)$">
  Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
